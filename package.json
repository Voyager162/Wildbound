{
  "name": "wildbound",
  "productName": "Wildbound",
  "version": "1.5.0",
  "description": "Wildbound is a desktop-first 2D adventure game.",
  "author": "Wildbound contributors",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "dev": "electron-forge start",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "package": "npm run typecheck && electron-forge package",
    "make": "npm run typecheck && electron-forge make",
    "make:win": "npm run typecheck && electron-forge make --platform=win32"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^2.1.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-squirrel-startup": "^1.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
